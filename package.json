{
  "name": "graktor-suite",
  "version": "1.0.0",
  "description": "Graktor Complete Suite — one installer that lets you choose, at first launch, between a cloud Graktor account and a license-key offline install. The local server the offline choice spawns is closed source; CI downloads a prebuilt copy into host/<platform>/ before packaging (see .github/workflows).",
  "main": "main.js",
  "author": "Zendoria Ventures",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zendoriaventures.graktorsuite",
    "productName": "Graktor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "chooser.html",
      "starting.html",
      "crashed.html",
      "offline.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "extraResources": [
        { "from": "host/win-x64", "to": "host" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Graktor"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "identity": null,
      "extraResources": [
        { "from": "host/osx-${arch}", "to": "host", "filter": ["**/*", "!*.pdb"] }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "extraResources": [
        { "from": "host/linux-x64", "to": "host" }
      ]
    }
  }
}
